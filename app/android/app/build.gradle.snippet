// Fragmento para app/android/app/build.gradle. El proyecto Gradle completo lo genera
// `flutter create`; aquí solo va lo que hay que añadir o cambiar.

android {
    namespace "com.ironcoding.perezar"
    compileSdk 34

    defaultConfig {
        applicationId "com.ironcoding.perezar"
        // ARCore exige 24 como mínimo. La arquitectura hablaba de Android 9 (API 28);
        // conviene fijarlo con los números reales del mercado objetivo antes de cerrar,
        // ver corrección #4 de docs/plan-de-trabajo.md.
        minSdk 24
        targetSdk 34
    }

    compileOptions {
        sourceCompatibility JavaVersion.VERSION_17
        targetCompatibility JavaVersion.VERSION_17
    }
    kotlinOptions { jvmTarget = "17" }
}

dependencies {
    // ARCore. Se declara siempre; que se USE lo decide en arranque
    // ArCoreApk.checkAvailability(), y si no está se cae a Camera2Driver.
    implementation "com.google.ar:core:1.42.0"
}
